    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst items = data.items;\nconst tvaRate = data.taux_tva;\n\nconst subTotal = items.reduce((acc, item) => acc + (item.prix * item.qty), 0);\nconst montantTVA = subTotal * tvaRate;\n\nlet remise = 0;\nif (subTotal > 3000000) {\n    remise = subTotal * 0.05;\n}\n\nconst totalFinal = subTotal + montantTVA - remise;\nconst formateur = new Intl.NumberFormat('fr-MG', { style: 'currency', currency: 'MGA' });\n\nreturn [{\n  json: {\n    client: data.client,\n    sub_total: formateur.format(subTotal),\n    tva: formateur.format(montantTVA),\n    remise: formateur.format(remise),\n    total_a_payer: formateur.format(totalFinal)\n  }\n}];"
      },
